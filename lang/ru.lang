# Help text
#
# One entry per help topic. Long lines: \n marks a line break in the
# message the user sees. Command names and their arguments stay in English,
# because they are what the user has to type.

# The main help listing: playback, queue and mode sections.
help_overview_playback = Справка по использованию бота:\n  gs : Показать приветственное сообщение и краткое руководство.\n  a : Показать информацию о боте.\n  dci : Показать контактную информацию разработчика.\n  log : Показать историю изменений.\n  h [команда] : Показать подробную справку по команде (Пример: h q). Если команда не указана, показать список доступных команд.\n  p [название трека / url] : Включить трек / URL. Если название / url не указаны, переключить воспроизведение/паузу текущего трека.\n  pn [название трека / url] : Добавить трек / URL в очередь для следующего воспроизведения. Повтор команды добавляет треки в порядке очереди.\n  th [количество] : Включить список топ-хитов и заменить текущую очередь.\n  lk : Включить любимые треки (только для сервиса Spotify).\n  src [название трека] : Найти и выбрать трек из результатов поиска для воспроизведения.\n  rp : Начать текущий трек заново с начала.\n  s : Остановить воспроизведение и очистить текущую очередь.\n  n : Включить следующий трек.\n  b : Включить предыдущий трек.\n  sn [значение] : Перемотать вперёд на указанное количество секунд.\n  sb [значение] : Перемотать назад на указанное количество секунд.\n  cti : Показать информацию о текущем треке.\n  q : Показать текущую очередь.\n  qc : Удалить все треки из очереди сразу.\n  q rm <номер индекса> : Удалить трек из очереди по номеру индекса.\n  v [0-100] : Изменить громкость. Если значение не указано, показать текущую громкость.\n  m [st / rt / tl / rtl] : Установить режим воспроизведения. Если режим не указан, показать активный режим и список режимов.\n  sfl : Включить / выключить перемешивание очереди.\n  ap : Включить / выключить автовоспроизведение (автоматические рекомендации по текущему треку).\n  dl : Скачать текущий трек или плейлист в канал.\n  gl : Получить ссылку на текущий трек.\n  lrc [название трека / исполнитель] : Показать текст трека. Если название / исполнитель не указаны, показать текст играющего трека.\n  srl [1-20] : Установить лимит результатов поиска. Если значение не указано, показать текущий лимит.

help_overview_spotify = 

help_overview_rest = Сервисы (активен сейчас: {service}).\n  spt : Переключиться на Spotify.\n  ytv : Переключиться на YouTube Video.\n  ytm : Переключиться на YouTube Music.\n  st : Показать время работы и статистику сессии.\n  cl [код языка] : Выбрать язык бота (только для вас, не влияет на других пользователей). Если код не указан, показать текущий язык.

help_overview_admin = Команды только для администраторов:\n  sds : Изменить настройки бота (сервер, пользователь, канал).\n  cci : Изменить данные клиента бота (никнейм, статус, пол, имя клиента).\n  cdl [код языка] : Установить язык сервера по умолчанию. Если код не указан, показать текущий язык по умолчанию.\n  ua [+имя_пользователя / -имя_пользователя] : Управление списком администраторов бота.\n  gci [путь к каналу] : Получить ID текущего канала или по указанному пути.\n  jc <путь / id канала|пароль> : Зайти в определенный канал. Пример: jc public|123.\n  hs : Скрыть / показать статус бота.\n  l : Заблокировать / разблокировать бота.\n  ucr : Включить / выключить ответ на неизвестные команды.\n  rs : Перезапустить бота.\n  sd : Выключить бота.

help_overview_footer = 

greetings = Здравствуйте!\nЯ {client_name}, бот для потокового воспроизведения медиа в TeamTalk. Я разработан на языке Rust и готов помочь вам транслировать музыку из Spotify, YouTube, а также по прямым аудиоссылкам в ваш канал TeamTalk.\nВы можете управлять мной, отправляя команды через личные сообщения или сообщения канала.\nПримечание: при использовании в сообщениях канала все команды должны начинаться с косой черты (/).\nВот несколько основных команд для начала работы:\n- Введите h для вывода полного списка команд и руководства.\n- Введите dci для просмотра контактной информации разработчика.\n- Введите log для просмотра истории изменений.\nЕсли у вас возникнут проблемы или вы захотите предложить новые функции для бота, свяжитесь с разработчиком по указанным контактам.\nСпасибо за использование {client_name}! Желаем отличного дня!

help_gs = gs\nПоказать приветственное сообщение и краткое руководство.

help_a = a\nПоказать информацию о боте.

dev_contact_info = Разработчик открыт для любых отзывов и сотрудничества.\nДля сообщений об ошибках, предложений по развитию или сотрудничества свяжитесь с разработчиком по контактам ниже.\nEmail : surel@fauzanaja.com\nWhatsApp : wa.me/fauzan_january\nTelegram : t.me/fauzan_january\n\nПолучайте интересные новости о проектах и разработках по следующим каналам.\nКанал WhatsApp : whatsapp.com/channel/0029VaFLXIO545upgh6w5h3K\nКанал Telegram : t.me/+30wgCgIaC9UzNTFl\nВеб-сайт : FauzanAja.com\n\nПоддержите работу разработчика чашечкой кофе.\nPaypal : donate@fauzanaja.com

help_dci = dci\nПоказать контактную информацию разработчика.

help_log = log\nПоказать историю изменений.

# Shown for an unrecognised command or help topic.
help_unknown = Неизвестная команда. Напишите h для списка команд.

help_play = p [запрос/url]\n  Найти и сразу включить трек по запросу или прямой ссылке (заменяет текущее воспроизведение).\n  Принимает названия, ссылки на треки, плейлисты, альбомы и прямые аудиопотоки.\n  Без запроса: переключает паузу и воспроизведение текущего трека.\nПримеры:\n  p photograph\n  p spotify:track:6rqhFgbbKwnb9MLmUQDhG6\n  p http://stream.zeno.fm/simplesample

help_play_next = pn [запрос/url]\n  Добавить треки из поиска или прямой ссылки в очередь без прерывания текущего трека.\n  Если ничего не играет, воспроизведение начнется сразу.\nПримеры:\n  pn photograph\n  pn spotify:track:6rqhFgbbKwnb9MLmUQDhG6

help_stop = s\nОстановить воспроизведение и очистить очередь.

help_next = n\nПерейти к следующему треку.\nЕсли автовоспроизведение включено и ничего не осталось, бот запросит рекомендации.

help_prev = b\nВернуться к предыдущему треку.\nПосле 3 секунд трека команда начинает его заново; нажмите ещё раз, чтобы вернуться назад. Команда rp всегда начинает заново.

help_replay = rp\nНачать текущий трек с начала.

help_current = cti\nПоказать текущий трек с позицией, длительностью и активными режимами.

help_queue = q\n  q              Показать текущий трек и то, что дальше.\n  qc             Удалить все предстоящие треки, оставив текущий.\n  q rm <N>       Удалить предстоящий трек под номером N.\n                 N=1 это трек после текущего.\nУже сыгранные треки не показываются.\nПримеры:\n  q rm 1         Удалить следующий предстоящий трек\n  q rm 3         Удалить третий предстоящий трек\n  qc             Удалить всё после текущего трека

help_mode = m [st|rt|tl|rtl]\n  st   Single Track (один трек и остановка)\n  rt   Repeat Track (повтор текущего трека)\n  tl   Track List (воспроизведение очереди по порядку)\n  rtl  Repeat Track List (повтор всей очереди)\n  m    Показать активный режим и список\nПеремешивание отдельно: смотрите 'h sfl'.

help_shuffle = sfl\nВключить или выключить перемешивание предстоящих треков (работает вместе с повтором).

help_volume = v [0-100]\n  v          Показать текущую громкость\n  v 50       Установить громкость 50%\n  v50        Установить 50% (без пробела)\nГромкость ограничена настроенным максимумом.

help_seek = sn / sb [секунды]\n  sn         Перемотать вперёд на 10 секунд\n  sb         Перемотать назад на 10 секунд\n  sn30       Перемотать вперёд на 30 секунд\n  sb 5       Перемотать назад на 5 секунд

help_search = src <запрос>\n  Найти и показать результаты. Затем:\n  <номер>    Выбрать результат для добавления в очередь\n  c          Убрать результаты\nПример:\n  src photograph\n  2          Выбрать второй результат

help_radio = ap\nПереключить режим автовоспроизведения (автоматические рекомендации после окончания очереди).

help_link = gl\nПолучить ссылку на текущий трек.\nОткройте её в приложении сервиса или поделитесь с другими.

help_stats = st\nВремя работы бота, сыгранные треки за сессию, длина очереди и громкость.

help_gci = gci [путь к каналу]\nПолучить числовой ID текущего канала или узнать ID по указанному пути.\nПримеры:\n  gci\n  gci /Music Room\n  gci Public

help_jc = jc <путь/ID>[|пароль]\nЗайти в канал TeamTalk по пути или ID (опционально: добавьте '|' и пароль, если канал защищён).\nПример: jc 2 или jc /Music Room или jc /VIP Lounge|пароль123

help_lang = cl [код]\nПоказать доступные языки или выбрать свой личный язык (только для вас, без кода: список языков).\nВыбор запоминается по имени пользователя.\ncl clear убирает ваш выбор (используется язык сервера).\nПример: cl de

help_glang = cdl [код]\nУстановить язык сервера по умолчанию (для администратора).\nУ тех, кто выбрал язык командой cl, он сохранится.

help_cci = cci\nИнтерактивно изменить информацию о клиенте бота (имя, статус, пол, имя клиента) (для администратора).

help_service = /spt / /ytv / /ytm\n  /spt    Переключить активный сервис на Spotify.\n  /ytv    Переключить активный сервис на YouTube Video.\n  /ytm    Переключить активный сервис на YouTube Music.\nКоманды p, pn, src, n, b работают с активным сервисом.\nПереключение не прерывает воспроизведение. Для остановки используйте s.

help_restart = rs\nПерезапустить бота. Настройки сохраняются перед выходом.

help_quit = sd\nВыключить бота. Настройки сохраняются перед выходом.

help_srl = srl [1-20]\n  srl       Показать текущий лимит результатов поиска\n  srl <N>   Установить лимит результатов поиска (1-20)\nОпределяет количество результатов, возвращаемых командой src.
help_sds = sds\nПросмотр и изменение настроек Сервера, Порта, Пользователя, Пароля и Канала.
help_lock = l\nБлокирует или разблокирует бота. Когда бот заблокирован, им могут управлять только администраторы.
help_hs = hs\nПереключение между скрытием и отображением статуса бота.
bot_locked = Бот заблокирован.
bot_locked_success = Бот заблокирован.
bot_unlocked_success = Бот разблокирован.
status_hidden_success = Статус бота скрыт.
status_shown_success = Статус бота показан.
help_ucr = ucr\nПереключение ответа на неизвестные, недействительные или недоступные команды.
ucr_enabled = Ответ на неизвестные команды включен.
ucr_disabled = Ответ на неизвестные команды выключен.
help_dl = dl\nИнтерактивная загрузка текущего трека или всего плейлиста в канал.
help_lrc = lrc [название трека / исполнитель]\n  Показать текст текущего трека или найти по названию / исполнителю.\n  Если название не указано, получает текст трека, который сейчас играет.\nПример:\n  lrc\n  lrc Bohemian Rhapsody\n  lrc Queen - Bohemian Rhapsody
help_th = th [количество]\n  Включить популярные топ-хиты сегодняшнего дня и заменить текущую очередь.\n  Можно указать количество треков (по умолчанию: 10, диапазон: 1-50).\nПримеры:\n  th\n  th 5\n  th 20
help_liked = lk\nВключить все треки из коллекции Любимые треки активного аккаунта Spotify (только для сервиса Spotify).
dl_no_track = В данный момент ничего не воспроизводится.
dl_live_stream = Прямые трансляции нельзя скачать.
dl_no_permission = У бота нет прав на загрузку файлов в этот канал.
dl_menu_target = Выберите объект загрузки:\n1. Только текущий трек ({title})\n2. Все треки в плейлисте/очереди ({count} треков)\n3. Отмена\nВведите номер выбора (1-3):
dl_menu_format = Выберите аудиоформат:\n1. .mp3 (Универсальная совместимость)\n2. .m4a (Высокое качество)\n3. .wav (PCM без сжатия)\n4. .ogg (Оригинальный формат Spotify)\n5. Отмена\nВведите номер выбора (1-5):
dl_downloading = Скачивание '{title}'...
dl_uploading = Загрузка '{title}' в канал...
dl_success = '{title}' успешно загружен в канал.
dl_quota_exceeded = Ошибка загрузки '{title}': Превышена дисковая квота канала.
dl_failed = Не удалось скачать или загрузить трек: {error}
dl_timeout = Время сеанса скачивания истекло.
dl_cancelled = Сеанс скачивания отменен.
dl_invalid_choice = Неверный выбор. Пожалуйста, введите правильный номер.
dl_already_active = Сеанс загрузки уже выполняется другим пользователем.

